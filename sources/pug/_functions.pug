/**
 * Get the resolution of the image from its name
 * @param {string} imgName - image name
 * @return {Array} - image width and height
 */
function getImageSize(imgName) {
    var match = imgName.match(/\d+x\d+/i);
    if (match !== null && match.length !== 0) return match[0].split('x');
    else return [];
}

/**
 * Sets the image extension if it is missing and adds 'images/' if the link is not external
 * @param {string} imgName - image name
 * @return {string}
 */
function procImg(imgName) {
    var extMatch = imgName.match(/(.jpg|.png|.gif)$/i),
        httpTest = /:\/\//.test(imgName);

    if (!httpTest && (extMatch === null || extMatch.length === 0)) imgName += '.jpg';
    if (!httpTest) imgName = 'images/' + imgName;

    return imgName;
}

/**
 * Generates link from string (turkish chars are normalized, spaces to -)
 * @param {string} string
 */
function genLink(string) {
    // İsteğe bağlı olarak Türkçe karakter düzeltmesi eklenebilir
    return string.trim().replace(/\s+/g, '-').replace(/[\(\)]/g, '').toLowerCase() + '.html';
}

/**
 * Returns random string
 * @param {number} length - string length
 */
function randomStr(length) {
    var str = '';
    for (var n = 0; n < length; n++)
        str += String.fromCharCode(97 + Math.floor(Math.random() * 26)); // A-Z: 26 harf!
    return str;
}

/**
 * Recursively processes menu data, adds a generated link if missing,
 * and attaches parent references to each menu item for navigation building.
 *
 * @param {Array} menu - Menu items array
 * @param {Object} parent - (Optional) Parent menu item
 */
function procMenu(menu, parent) {
    menu.forEach(function(item) {
        if (parent) item._parent = parent;
        if (!Array.isArray(item) && item.title && typeof(item.link) === 'undefined')
            item.link = genLink(item.title);

        if (item.dropdown)
            procMenu(item.dropdown, item);
        else if (item.megamenu)
            procMenu(item.megamenu, item);
        else if (item.list)
            procMenu(item.list, item);
        else if (Array.isArray(item))
            procMenu(item, item);
    });
}

// Eğer global kullanacaksan:
let directMenuPassEnd = false;

function directMenuPass(menu, cb) {
    for (var i = 0; i < menu.length; i++) {
        var item = menu[i];
        if (directMenuPassEnd) break;
        if (cb && cb(item)) directMenuPassEnd = true;
        if (item.dropdown) directMenuPass(item.dropdown, cb);
        else if (item.megamenu) directMenuPass(item.megamenu, cb);
        else if (item.list) directMenuPass(item.list, cb);
        else if (Array.isArray(item)) directMenuPass(item, cb);
    }
}

function inverseMenuPass(item, cb) {
    if (cb) cb(item);
    if (item._parent) inverseMenuPass(item._parent, cb);
}

function main() {
    // menu, pageName ve breadcrumbs değişkenlerinin global tanımlı olduğuna emin ol!
    procMenu(menu);

    directMenuPass(menu, function(item) {
        if (item.title && item.title.toLowerCase() === pageName.toLowerCase()) {
            inverseMenuPass(item, function(item) {
                item.active = true;
                if (!item.list) breadcrumbs.unshift(item);
            });
            return true;
        }
    });
}
